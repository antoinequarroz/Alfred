# --- Connexion à Alfred -------------------------------------------------------
# Empreinte du mot de passe, générée par : npm run hash-password -- "ton mot de passe"
ALFRED_PASSWORD_HASH=

# Les identifiants iCloud et l'envoi des e-mails se règlent aussi dans l'app (Réglages, et
# Rendez-vous > Réglages) : une valeur enregistrée dans l'app passe avant celle de ce fichier.

# --- iCloud (CalDAV) ----------------------------------------------------------
# Identifiant Apple et mot de passe d'application (account.apple.com > Connexion
# et sécurité > Mots de passe pour les apps). Jamais ton vrai mot de passe Apple.
CALDAV_URL=https://caldav.icloud.com
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Intervalle de synchronisation en secondes (iCloud ne prévient pas, on l'interroge).
CALDAV_SYNC_INTERVAL=120

# --- Prise de rendez-vous : e-mails (SMTP) -------------------------------------
# Sans SMTP_USER et SMTP_PASSWORD, la prise de RDV fonctionne mais n'envoie aucun e-mail.
# Le plus simple : les saisir dans l'app (Rendez-vous > Réglages). deploy/configurer.sh les demande
# aussi (saisie masquée, facultative).
# Port 587 = STARTTLS (défaut), 465 = TLS implicite.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Antoine Quarroz <info@antoinequarroz.ch>"
# Adresse qui reçoit les avis de nouveau RDV et d'annulation (défaut : l'adresse de MAIL_FROM).
MAIL_NOTIFY_TO=
# Adresse publique d'Alfred, utilisée pour les liens d'annulation dans les e-mails.
ALFRED_PUBLIC_URL=https://alfred.antoinequarroz.ch

# --- Mots de passe enregistrés dans l'app ---------------------------------------
# Facultatif. Les mots de passe saisis dans l'app sont chiffrés dans la base. Sans cette
# variable, la clé est un fichier créé tout seul dans le dossier de données (data/secret.key,
# à sauvegarder avec la base). Pour garder la clé hors du volume : 32 octets en hexadécimal,
# générés par « openssl rand -hex 32 ». Si elle change ou se perd, les mots de passe
# enregistrés dans l'app sont à ressaisir.
ALFRED_SECRET_KEY=

# --- Divers -------------------------------------------------------------------
ALFRED_TIMEZONE=Europe/Zurich
# Développement seulement : accepte, dans les réglages de l'app, les serveurs internes
# (127.0.0.1, réseau privé) et un serveur CalDAV en http. Ne jamais l'activer sur le VPS.
# ALFRED_ALLOW_PRIVATE_HOSTS=1
