# Copie ce fichier en .env sur le VPS (cp .env.example .env) et remplis-le.
# Ne commite JAMAIS le fichier .env (il est dans .gitignore).

# --- Adresse publique ------------------------------------------------------
# Sous-domaine dédié, ex. https://rdv.mondomaine.ch (DNS A/AAAA vers le VPS)
NEXT_PUBLIC_WEBAPP_URL=https://rdv.example.ch
# Hôte (sans https://) autorisé par Cal.com, entre guillemets doubles
ALLOWED_HOSTNAMES='"rdv.example.ch"'

# --- Base de données (dédiée, ne touche pas à tes Supabase) ----------------
POSTGRES_USER=calcom
POSTGRES_DB=calcom
# Génère avec : openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Secrets Cal.com --------------------------------------------------------
# openssl rand -base64 32
NEXTAUTH_SECRET=
# 32 caractères exactement : openssl rand -base64 24
# Chiffre tes identifiants iCloud en base : garde-le précieusement, ne le change plus.
CALENDSO_ENCRYPTION_KEY=
# openssl rand -hex 16
CRON_API_KEY=

# --- E-mails (confirmations, rappels, annulations) -------------------------
# Exemple Infomaniak : mail.infomaniak.com, port 587, ton adresse et son mot de passe.
EMAIL_FROM=rdv@example.ch
EMAIL_FROM_NAME=Antoine
EMAIL_SERVER_HOST=mail.infomaniak.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=rdv@example.ch
EMAIL_SERVER_PASSWORD=

# --- Personnalisation -------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Alfred
NEXT_PUBLIC_COMPANY_NAME=Alfred
NEXT_PUBLIC_SUPPORT_MAIL_ADDRESS=rdv@example.ch

# --- Réglages ressources (valeurs par défaut prévues pour le VPS actuel) ----
CALCOM_VERSION=v6.2.0
CALCOM_PORT=3100
CALCOM_MEM_LIMIT=1g
CALCOM_NODE_HEAP_MB=640

# --- Seulement si Caddy tourne dans Docker (voir docker-compose.caddy-network.yml)
# CADDY_NETWORK=
