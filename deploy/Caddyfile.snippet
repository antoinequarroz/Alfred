# À ajouter au Caddyfile existant, une fois le DNS alfred.postmelo.ch créé.
# Caddy tourne en conteneur : il joint Alfred par son nom sur le réseau Docker partagé.
alfred.postmelo.ch {
	encode zstd gzip
	# Visio : la signalisation WebSocket de LiveKit (/rtc) va au serveur de visio, tout le reste à Alfred.
	handle /rtc* {
		reverse_proxy alfred-livekit:7880
	}
	handle {
		reverse_proxy alfred:3200
	}
}

# Ancienne adresse (avant PostMelo, novembre 2026) : redirection permanente, chemin compris,
# pour que les liens déjà envoyés (rendez-vous, gestion, visios) continuent de marcher.
alfred.antoinequarroz.ch {
	redir https://alfred.postmelo.ch{uri} permanent
}
